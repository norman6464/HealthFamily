# PostgreSQL 接続文字列（Render Postgres の Internal Connection String）
DATABASE_URL=postgres://user:password@localhost:5432/healthfamily?sslmode=disable

# JWT 署名鍵（必須・ランダムな長い文字列）
JWT_SECRET=change-me-to-a-long-random-secret

# 起動時マイグレーション対象ディレクトリ（設定すると自動適用）
MIGRATIONS_DIR=migrations

# CORS 許可オリジン（カンマ区切り。フロントエンドのURL）
ALLOWED_ORIGINS=http://localhost:5173

# メール送信（任意。未設定なら送信スキップしログ出力のみ）
RESEND_API_KEY=
MAIL_FROM=HealthFamily <onboarding@resend.dev>

# 待受ポート（Render では自動注入されるため通常は未設定でよい）
PORT=8080

# Google OIDC ログイン用 OAuth クライアントID（未設定ならGoogleログイン無効）
GOOGLE_CLIENT_ID=
